{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "result": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["confirmed", "fail"]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": ["verdict", "summary"]
    }
  },
  "required": ["result"],
  "_required_files": [
    {
      "name": "修改日志",
      "path": "modification_log.md"
    }
  ]
}