    "runtime_requirements": "COMSOL Server port 2036 (mphstart), MATLAB LiveLink",
    "startup_guide": {
      "precondition": "COMSOL mphserver 需独立终端长期运行在端口 2036（非临时启动，单客户端模式会自杀）",
      "check_comsol": "在 MATLAB 中执行 mphstart(2036)，若报错 'Already connected' 说明已连接",
      "matlab_invoke": "matlab -batch \"cd('d:\\ZJU\\PROJECT\\2026-07-02-qoder-engine\\COMSOL\\pipline'); addpath('config','experiment'); state = run_experiment('plugin_a12'); save('experiment_output.mat', 'state', '-v7.3'); \"",
      "addpath_required": "必须显式 addpath config 和 experiment 目录，否则函数未定义",
      "encoding": "Windows 下 MATLAB stdout 需确保 UTF-8 输出不乱码"
    },
    "key_params": {
      "parameterization": "p.n_cx, p.n_cy, p.n_cz (B-spline 控制点数)",
      "regularization": "p.weight_strategy (uniform|adaptive|chebyshev), p.chebyshev_eta",
      "iteration": "p.max_iter, p.eps_tol, p.mu_init, p.grad_clip",
      "constraints": "p.eps_r_min, p.eps_r_max",
      "plugin": "p.inversion_plugin (plugin_basic|plugin_a12|plugin_c01)"
    },
    "param_modification_guide": "修改 config/config.m 中 p 结构体的对应字段",
    "plugin_dir": "algorithm/",
    "plugin_signature": "function state = run_inversion(model, voxel, lc, grid, p)",
    "plugin_params": {
      "model": "COMSOL 模型句柄",
      "voxel": "体素网格信息（含 epsilon_r, mask_interior）",
      "lc": "光锥投影数据（含 J_obs_perp, k_dir, k_vec）",
      "grid": "测量网格",
      "p": "全局参数（config.m 产出）"
    },
    "state_fields": {
      "converged": "bool — 是否收敛",
      "iteration": "int — 迭代轮数",
      "residual": "float — 最终残差",
      "history_J_hyp": "N_k × 2 × N_iter — J_hyp 历史"
    },
    "execution_steps": [
      "setup() + config() — 初始化参数",
      "mphstart(port) + mphload(model) — 连接 COMSOL Server",
      "fem_mesh_utils — 提取 FEM 体素网格",
      "设真值 eps_r — 设散射体介电常数",
      "solve_forward — COMSOL 正演求解",
      "extract_scattered + lightcone_project — 计算 J_obs",
      "fibonacci_sphere — 构建光锥方向",
      "addpath(plugin_dir) + run_inversion — 加载插件运行反演",
      "三件套指标输出 — cos θ / F_cheb / 收敛信息"
    ]
  }
