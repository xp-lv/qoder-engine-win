          "param_type": "voxel",
          "description": "core_inversion/inversion_loop 直接体素迭代"
        },
        "plugin_a12": {
          "algorithm": "A12 B-spline + TV 多频反演",
          "param_type": "b-spline",
          "description": "B-spline 参数化 + Chebyshev 加权 + TV 正则化"
        },
        "plugin_c01": {
          "algorithm": "C01 复数均匀球反演",
          "param_type": "uniform",
          "description": "均匀复数介电常数单参数反演"
        }
      },
      "matlab": {
        "comsol_port": 2036,
        "comsol_version": "6.2",
        "matlab_version": "R2023b"
      },
      "validated": {
        "date": "2026-07-03",
        "voxel_count": 673,
        "v5a_pass": true,
        "experiments_run": 50
      }
    },
    "gen1_comsol_adjoint": {
      "name": "pipline_adjoint 伴随法验证管线",
      "status": "stable",
      "created": "2026-07-28",
      "abs_path": "d:\\ZJU\\PROJECT\\2026-07-02-qoder-engine\\COMSOL\\pipline_adjoint",
      "model_file": "d:\\ZJU\\PROJECT\\2026-07-02-qoder-engine\\COMSOL\\pipline_adjoint\\2layer.mph",
      "entry_script": "d:\\ZJU\\PROJECT\\2026-07-02-qoder-engine\\COMSOL\\pipline_adjoint\\experiment\\verify_per_voxel.m",
      "config_script": "d:\\ZJU\\PROJECT\\2026-07-02-qoder-engine\\COMSOL\\pipline_adjoint\\config\\config.m",
      "capabilities": {
        "forward": {
          "method": "COMSOL_mphinterp",
